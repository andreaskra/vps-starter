# Written automatically by setup.sh — you normally never edit this file.
# API keys do NOT go here; they are entered in the dashboard (Settings).

# PBKDF2 hash of your dashboard password (setup.sh prompts you and fills this in)
DASHBOARD_PASSWORD_HASH=

# Random secret for session cookies (generated by setup.sh)
SECRET_KEY=

# This server's public IP (detected by setup.sh; used for domain DNS checks)
PUBLIC_IP=

# 1 = demo mode: fabricate lead results, never call paid APIs
DRY_RUN=0

# 1 = use Let's Encrypt's staging environment (testing only — fake certificates)
CERT_STAGING=0
